# Servidor web local "scriptorium": sirve ~/src/html con listado de
# directorios navegable. Lo arranca el LaunchAgent com.fran.scriptorium a
# través de scriptorium-serve.sh.
#
# Escucha en :8080 sin matcher de host, así que responde a cualquier Host
# (localhost, scriptorium, …). La resolución del nombre `scriptorium` y la
# redirección del puerto 80 -> 8080 las hace scriptorium-root-setup.sh.
#
# {$HOME} lo sustituye el adaptador Caddyfile con la variable de entorno HOME
# del proceso (el LaunchAgent la hereda). launchd no expande $HOME en rutas.

{
	admin off
	auto_https off
}

:8080 {
	root * {$HOME}/src/html
	# Artefactos en edición constante: revalidar siempre (304 si no cambió, 200 si
	# sí) para que el panel lector (iframe) no muestre versiones cacheadas viejas.
	header Cache-Control "no-cache"

	# Proxy same-origin hacia el bridge del botón «Compartir»
	# (macos/scriptorium-share.py, solo loopback en 127.0.0.1:8737). Este
	# :8080 escucha en todas las interfaces, así que restringimos la ruta a
	# peticiones que ya llegan desde el propio Mac (127.0.0.1/::1); cualquier
	# otra IP de la LAN recibe 403 y no puede disparar publicaciones.
	@share-not-local not remote_ip 127.0.0.1 ::1
	handle_path /-/* {
		respond @share-not-local 403
		reverse_proxy 127.0.0.1:8737
	}

	# Los .md se sirven renderizados en vez de descargarse: scriptorium-md.html
	# (en ~/.config/caddy) los envuelve con el estilo del visor. Así un plan o
	# una spec se lee en el panel lector sin generarle a mano un gemelo .html
	# que se queda viejo en cuanto se edita el markdown.
	#
	# La subdirectiva `root` de `templates` es lo que permite tener la plantilla
	# fuera del árbol de documentos: file_server sirve el shell desde
	# ~/.config/caddy y `readFile` resuelve el .md contra ~/src/html.
	#
	# El matcher exige que el fichero exista (`file`): sin esa condición un .md
	# inexistente da 500 —readFile falla dentro de la plantilla— en vez de caer
	# en el 404 normal del file_server de abajo.
	@md {
		path *.md
		file
	}
	handle @md {
		route {
			root * {$HOME}/.config/caddy
			rewrite * /scriptorium-md.html
			templates {
				root {$HOME}/src/html
			}
			file_server
		}
	}

	file_server {
		# Sin resolución de ficheros índice: el catálogo (browse) expande cada
		# carpeta pidiendo su listado JSON, y un index.html en la carpeta lo
		# taparía (Caddy serviría el fichero y el árbol la pintaría vacía).
		index off
		browse {$HOME}/.config/caddy/scriptorium-browse.html
		# Fichero interno del bridge de compartir (y su temporal atómico de
		# escritura): no deben salir en el listado del catálogo.
		hide .scriptorium-shares.json .scriptorium-shares-*.tmp
	}
	encode gzip
}
