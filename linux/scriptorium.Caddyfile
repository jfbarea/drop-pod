# Servidor web local "scriptorium": sirve ~/src/html con listado de
# directorios navegable. Lo arranca la unit de usuario scriptorium.service.
#
# Escucha en :8081 (no en :8080 como en macOS) porque en esta máquina el 8080
# lo ocupa magos-wiki.service. Sin matcher de host, así que responde a
# cualquier Host (localhost, la IP de la Pi, …).
#
# A diferencia de macOS, aquí no hay redirección del puerto 80 ni entrada en
# /etc/hosts: se accede por http://localhost:8081 directamente.
#
# {$HOME} lo sustituye el adaptador Caddyfile con la variable de entorno HOME
# del proceso (systemd --user la exporta).

{
	admin off
	auto_https off
}

:8081 {
	root * {$HOME}/src/html
	# Artefactos en edición constante: revalidar siempre (304 si no cambió, 200 si
	# sí) para que el panel lector (iframe) no muestre versiones cacheadas viejas.
	header Cache-Control "no-cache"
	# Los .md se sirven renderizados en vez de descargarse: scriptorium-md.html
	# (en ~/.config/caddy) los envuelve con el estilo del visor. Así un plan o
	# una spec se lee en el panel lector sin generarle a mano un gemelo .html
	# que se queda viejo en cuanto se edita el markdown.
	#
	# La subdirectiva `root` de `templates` es lo que permite tener la plantilla
	# fuera del árbol de documentos: file_server sirve el shell desde
	# ~/.config/caddy y `readFile` resuelve el .md contra ~/src/html.
	#
	# El matcher exige que el fichero exista (`file`): sin esa condición un .md
	# inexistente da 500 —readFile falla dentro de la plantilla— en vez de caer
	# en el 404 normal del file_server de abajo.
	@md {
		path *.md
		file
	}
	handle @md {
		route {
			root * {$HOME}/.config/caddy
			rewrite * /scriptorium-md.html
			templates {
				root {$HOME}/src/html
			}
			file_server
		}
	}

	file_server {
		browse {$HOME}/.config/caddy/scriptorium-browse.html
	}
	encode gzip
}
